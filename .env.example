# ============================================
# Home Control Center — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ---- Database ----
DATABASE_URL="mysql://hcc:hcc_password@localhost:3306/home_control_center"
# Used inside Docker Compose (points to the mysql service name)
# DATABASE_URL="mysql://hcc:hcc_password@mysql:3306/home_control_center"

# ---- Authentication ----
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-here"
# Allowed origins for auth (comma-separated)
NEXTAUTH_URL="http://localhost:3000"

# ---- Encryption ----
# AES-256 key for encrypting server credentials
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY="your-64-char-hex-encryption-key-here"

# ---- Resend Email ----
RESEND_API_KEY=""
EMAIL_FROM="Home Control Center <alerts@yourdomain.com>"

# ---- Unraid ----
UNRAID_URL=""
UNRAID_API_KEY=""

# ---- Nextcloud ----
NEXTCLOUD_URL=""
NEXTCLOUD_USERNAME=""
NEXTCLOUD_APP_PASSWORD=""

# ---- PWA / Push Notifications ----
# Generate VAPID keys: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:your-email@example.com"

# ---- App Settings ----
NODE_ENV="production"
# Polling interval in seconds (default: 60)
POLLING_INTERVAL="60"
# Report schedule (cron expressions)
DAILY_REPORT_CRON="0 8 * * *"
WEEKLY_REPORT_CRON="0 9 * * 1"

# ---- Worker ----
WORKER_API_URL="http://app:3000"
WORKER_API_SECRET="your-worker-secret-here"

# ---- MySQL (Docker Compose) ----
MYSQL_ROOT_PASSWORD="root_password_change_me"
MYSQL_DATABASE="home_control_center"
MYSQL_USER="hcc"
MYSQL_PASSWORD="hcc_password"
